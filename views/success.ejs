<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Uploaded</title>
<script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
<div class="bg-white p-8 rounded shadow w-96">
<h1 class="text-2xl font-bold mb-4">Upload Complete</h1>
<ul class="mb-4 space-y-2">
<% files.forEach(function(f){ %><li class="border p-2 rounded"><%= f.original %></li><% }); %>
</ul>
<a href="/files" class="bg-blue-600 text-white px-4 py-2 rounded">Manage & Download</a>
</div>
</body></html>
