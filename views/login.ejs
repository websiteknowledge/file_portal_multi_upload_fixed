<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login</title>
<script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
<form method="POST" action="/login" class="bg-white p-8 rounded shadow w-96">
<h1 class="text-2xl font-bold mb-4">Enter Site Password</h1>
<% if (error) { %><div class="text-red-600 mb-2"><%= error %></div><% } %>
<input name="password" type="password" placeholder="Password" class="w-full p-2 border rounded mb-4" required>
<button class="w-full bg-blue-600 text-white p-2 rounded">Enter</button>
</form>
</body></html>
