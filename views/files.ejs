<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Files</title>
<script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-100 min-h-screen p-8">
<div class="max-w-3xl mx-auto bg-white p-6 rounded shadow">
<h1 class="text-2xl font-bold mb-4">Uploaded Files</h1>
<ul class="space-y-2">
<% if(files.length===0){ %><li class="text-gray-600">No files uploaded yet.</li><% } %>
<% files.forEach(function(f){ %>
<li class="border p-2 rounded flex justify-between items-center">
<span><%= f.original %></span>
<a href="/download/<%= f.original %>" class="bg-green-600 text-white px-2 py-1 rounded text-sm">Download</a>
</li>
<% }); %>
</ul>
<a href="/upload" class="block mt-4 text-sm text-gray-600">Upload more files</a>
</div>
</body></html>
